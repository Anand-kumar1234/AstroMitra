rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "gulshankumar9934293812@gmail.com";
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.get('location', '') is string && data.get('location', '').size() <= 200) &&
             (data.get('religion', '') is string && data.get('religion', '').size() <= 100) &&
             (data.get('caste', '') is string && data.get('caste', '').size() <= 100) &&
             (data.get('rashi', '') is string && data.get('rashi', '').size() <= 50) &&
             (data.get('birthDate', '') is string && data.get('birthDate', '').size() <= 20) &&
             (data.get('birthTime', '') is string && data.get('birthTime', '').size() <= 10) &&
             (data.get('birthPlace', '') is string && data.get('birthPlace', '').size() <= 200);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'utr', 'amount', 'status']) &&
             data.userId == request.auth.uid &&
             data.utr is string && data.utr.size() >= 4 && data.utr.size() <= 64 &&
             data.amount == 5 &&
             data.status is string && data.status.size() <= 30;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && 
                      isValidUserProfile(incoming()) && 
                      incoming().userId == existing().userId;
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
